<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        QWeb template used to render the portal invitation email body.

        Called from Python via:
            self.env['ir.qweb']._render(
                'portal_starter.portal_invite_email_body',
                {'object': partner, 'company': company, 'portal_link': url, 'user': user},
            )

        Variables available inside the template:
            object  – res.partner record (the invitee)
            company – res.company record (partner.company_id or env.company)
            portal_link – str, full URL to the portal (https://...)
            user    – res.users record (the sender)
            custom_message – str (optional personal note, may be empty)
    -->
    <template id="portal_invite_email_body" name="Portal Invite Email Body">
        <div style="margin: 0; padding: 0; font-size: 14px;">
            <table width="100%" cellpadding="0" bgcolor="#f4f4f4" style="padding: 20px;">
                <tr>
                    <td align="center">
                        <table width="600" cellpadding="0" cellspacing="0" bgcolor="#ffffff"
                               style="border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                            <!-- Header -->
                            <tr>
                                <td bgcolor="#1C6EF2" style="padding: 30px 40px; text-align: center;">
                                    <h1 t-esc="company.name"
                                        style="margin: 0; color: #ffffff; font-size: 24px;"/>
                                    <p style="margin: 8px 0 0 0; color: rgba(255,255,255,0.9);">
                                        Customer Portal Access
                                    </p>
                                </td>
                            </tr>
                            <!-- Body -->
                            <tr>
                                <td style="padding: 30px 40px;">
                                    <p>
                                        Hello <strong t-esc="object.name"/>,
                                    </p>
                                    <p>You have been granted access to our customer portal.
                                        Here you can manage your orders, invoices, deliveries,
                                        and more.
                                    </p>
                                    <p style="text-align: center; margin: 30px 0;">
                                        <a t-attf-href="{{ portal_link }}"
                                           style="background-color: #1C6EF2; color: white;
                                                  padding: 14px 32px; text-decoration: none;
                                                  border-radius: 6px; font-weight: bold;
                                                  display: inline-block;">
                                            Access Your Portal
                                        </a>
                                    </p>
                                    <t t-if="custom_message">
                                        <p style="background: #f8f9fa; padding: 15px;
                                                  border-left: 4px solid #1C6EF2;
                                                  border-radius: 4px;">
                                            <t t-esc="custom_message"/>
                                        </p>
                                    </t>
                                    <p>If the button above doesn't work, copy and paste this
                                        link into your browser:
                                    </p>
                                    <p t-esc="portal_link"
                                       style="color: #1C6EF2; word-break: break-all;"/>
                                </td>
                            </tr>
                            <!-- Footer -->
                            <tr>
                                <td style="padding: 20px 40px; background: #f8f9fa;
                                           text-align: center; color: #6c757d; font-size: 12px;">
                                    <p style="margin: 0;">
                                        <t t-esc="company.name"/>
                                        <t t-if="company.phone">
                                            &amp;mdash; <t t-esc="company.phone"/>
                                        </t>
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </template>
</odoo>