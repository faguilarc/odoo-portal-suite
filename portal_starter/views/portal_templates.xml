<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal Document List Page -->
    <template id="portal_document_list_page" name="Portal Document List Page">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <div class="container oe_structure">

                <!-- Page Header -->
                <div class="mb-4">
                    <h1>
                        <i t-attf-class="fa {{ doc_type.icon or 'fa-file' }}"
                           t-attf-style="color: {{ doc_type.color or '#1C6EF2' }};"/>
                        <t t-field="doc_type.name"/>
                    </h1>
                    <p class="text-muted" t-field="doc_type.description"/>
                </div>

                <!-- Search & Filter Bar -->
                <div class="card mb-4">
                    <div class="card-body">
                        <form t-attf-action="/my/documents/{{ doc_type.code }}"
                              method="get" class="form-inline">
                            <div class="form-group mr-3">
                                <input type="text" name="search"
                                       t-attf-value="{{ search or '' }}"
                                       class="form-control"
                                       placeholder="Search documents..."/>
                            </div>
                            <div class="form-group mr-3">
                                <select name="sortby" class="form-control">
                                    <option value="date_desc"
                                            t-att-selected="'date_desc' == sortby">
                                        Newest First
                                    </option>
                                    <option value="date_asc"
                                            t-att-selected="'date_asc' == sortby">
                                        Oldest First
                                    </option>
                                    <option value="name_asc"
                                            t-att-selected="'name_asc' == sortby">
                                        Name A-Z
                                    </option>
                                    <option value="name_desc"
                                            t-att-selected="'name_desc' == sortby">
                                        Name Z-A
                                    </option>
                                    <option value="amount_desc"
                                            t-att-selected="'amount_desc' == sortby">
                                        Highest Amount
                                    </option>
                                    <option value="amount_asc"
                                            t-att-selected="'amount_asc' == sortby">
                                        Lowest Amount
                                    </option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-search"/>
                                Search
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Documents Table -->
                <div class="card">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Reference</th>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="documents" t-as="doc">
                                    <tr>
                                        <td>
                                            <a t-attf-href="/my/documents/{{ doc_type.code }}/{{ doc.id }}"
                                               class="font-weight-bold">
                                                <t t-esc="doc.name"/>
                                            </a>
                                        </td>
                                        <td t-esc="doc.create_date[:10]"/>
                                        <td>
                                            <t t-if="hasattr(doc, 'amount_total')">
                                                <t t-esc="doc.currency_id.symbol"/>
                                                <t t-esc="'{:,.2f}'.format(doc.amount_total)"/>
                                            </t>
                                        </td>
                                        <td>
                                            <span class="badge badge-pill"
                                                  t-attf-style="background-color: {{ getattr(doc, 'state', '') == 'done' and '#28a745' or getattr(doc, 'state', '') == 'cancel' and '#dc3545' or '#ffc107' }}; color: white;">
                                                <t t-esc="getattr(doc, 'state', 'N/A').replace('_', ' ').title()"/>
                                            </span>
                                        </td>
                                        <td class="text-right">
                                            <a t-attf-href="/my/documents/{{ doc_type.code }}/{{ doc.id }}"
                                               class="btn btn-sm btn-outline-primary mr-1">
                                                <i class="fa fa-eye"/>
                                                View
                                            </a>
                                            <a t-attf-href="/my/documents/{{ doc_type.code }}/{{ doc.id }}/download"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="fa fa-download"/>
                                                PDF
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="not documents">
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-5">
                                            <i class="fa fa-folder-open fa-3x mb-3 d-block"/>
                                            <p>No documents found.</p>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Pager -->
                <t t-if="pager">
                    <div class="mt-4" t-raw="pager"/>
                </t>
            </div>
        </t>

    </template>

    <!-- Portal Document Detail Page -->
    <template id="portal_document_detail_page" name="Portal Document Detail Page">
        <t t-call="portal.portal_layout">

            <div class="container oe_structure">

                <!-- Back Button -->
                <a t-attf-href="/my/documents/{{ doc_type.code }}"
                   class="btn btn-outline-secondary mb-4">
                    <i class="fa fa-arrow-left"/>
                    Back to list
                </a>

                <!-- Document Header -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h2 t-esc="document.name"/>
                                <p class="text-muted mb-0">
                                    <t t-esc="doc_type.name"/>

                                    <t t-esc="getattr(document, 'create_date', '')[:10]"/>
                                </p>
                            </div>
                            <div>
                                <a t-attf-href="/my/documents/{{ doc_type.code }}/{{ document.id }}/download"
                                   class="btn btn-primary">
                                    <i class="fa fa-download"/>
                                    Download PDF
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Document Lines (dynamic based on model) -->
                <t t-if="hasattr(document, 'order_line') or hasattr(document, 'invoice_line_ids')">
                    <div class="card mb-4">
                        <div class="card-header font-weight-bold">Lines</div>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Description</th>
                                        <th class="text-right">Quantity</th>
                                        <th class="text-right">Unit Price</th>
                                        <th class="text-right">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="document.order_line or document.invoice_line_ids"
                                       t-as="line">
                                        <tr>
                                            <td t-esc="line.name"/>
                                            <td class="text-right"
                                                t-esc="line.quantity or line.quantity"/>
                                            <td class="text-right"
                                                t-esc="'{:.2f}'.format(line.price_unit or 0)"/>
                                            <td class="text-right font-weight-bold"
                                                t-esc="'{:.2f}'.format(line.price_subtotal or 0)"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>

                <!-- Totals -->
                <t t-if="hasattr(document, 'amount_total')">
                    <div class="card">
                        <div class="card-body text-right">
                            <t t-if="hasattr(document, 'amount_untaxed')">
                                <p class="mb-1">
                                    Subtotal:
                                    <strong t-esc="'{:.2f}'.format(document.amount_untaxed)"/>
                                </p>
                            </t>
                            <t t-if="hasattr(document, 'amount_tax')">
                                <p class="mb-1">
                                    Tax:
                                    <strong t-esc="'{:.2f}'.format(document.amount_tax)"/>
                                </p>
                            </t>
                            <h3 class="mt-3">
                                Total:
                                <t t-esc="document.currency_id.symbol"/>
                                <t t-esc="'{:.2f}'.format(document.amount_total)"/>
                            </h3>
                        </div>
                    </div>
                </t>

            </div>

        </t>
    </template>

</odoo>
